# ==============================================================================
# MoodFeed Environment Configuration (.env.example)
# Copy this file to .env and configure your environment variables.
# NEVER commit real .env files with production secrets to version control.
# ==============================================================================

# --- Application & Runtime Environment ---
# Allowed values: development, staging, production
APP_ENV=development
APP_NAME=MoodFeed
APP_VERSION=1.0.0
APP_BASE_URL=http://localhost:8000
API_BASE_URL=http://localhost:8000/v1
DEBUG=true

# --- Server & Networking ---
HOST=0.0.0.0
PORT=8000
WORKERS=2
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000","http://127.0.0.1:8000"]
CSRF_ORIGIN=http://localhost:8000

# --- Database & Connection Pooling (PostgreSQL 16) ---
DATABASE_URL=postgresql://moodfeed_user:replace_with_secure_password@localhost:5432/moodfeed_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_TIMEOUT_SECONDS=30
DATABASE_SSL_MODE=prefer

# --- Authentication & Secrets ---
# In production, SESSION_SECRET and JWT_SECRET MUST be generated with high entropy (e.g. openssl rand -hex 32)
SESSION_SECRET=dev_insecure_session_secret_replace_in_production_min32chars
JWT_SECRET=dev_insecure_jwt_secret_replace_in_production_min32chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=14
PASSWORD_HASH_ALGORITHM=argon2id

# --- Rate Limiting & Caching (Redis) ---
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_REDIS_URL=redis://localhost:6379/1
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# --- Content Ingestion & Provider ---
CONTENT_PROVIDER_ENABLED=false
CONTENT_PROVIDER_TYPE=rss
CONTENT_PROVIDER_BASE_URL=https://example.com/feed.xml
CONTENT_PROVIDER_API_KEY=
CONTENT_PROVIDER_SYNC_INTERVAL_MINUTES=30
CONTENT_PROVIDER_TIMEOUT_SECONDS=10

# --- Signal & ML Pipeline ---
# Allowed values: rule_based, berturk
MODEL_PROVIDER=rule_based
MODEL_NAME=dbmdz/bert-base-turkish-sentiment-cased
MODEL_VERSION=1.0.0
MODEL_TIMEOUT_MS=500
MODEL_DEVICE=cpu
MODEL_BATCH_SIZE=16

# --- Observability, Telemetry & Logging ---
# Allowed values: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
LOG_FORMAT=json
SENTRY_DSN=
OTEL_EXPORTER_ENDPOINT=
OTEL_SERVICE_NAME=moodfeed-service
METRICS_ENABLED=true

# --- Data Export & Privacy Signing ---
EXPORT_SIGNING_SECRET=dev_export_signing_secret_replace_in_production_min32chars
EXPORT_URL_TTL_SECONDS=900
DATA_RETENTION_DAYS=90

# --- Feature Flags ---
FEATURE_FLAG_MOCK_ADAPTER=true
FEATURE_FLAG_AUTH=true
FEATURE_FLAG_PERSISTENCE=true
FEATURE_FLAG_PILOT_MODE=true
FEATURE_FLAG_BERTURK_INFERENCE=false

# --- Admin & Service Role Configuration ---
ADMIN_ROLE_CONFIG={"admin_email":"admin@moodfeed.local","default_role":"admin"}
