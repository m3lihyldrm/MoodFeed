# MoodFeed Environment Configuration Example (Placeholders only)

APP_ENV=development
PORT=8000
DATABASE_URL=postgresql://user:pass@localhost:5432/moodfeed_db
CORS_ORIGINS=https://mood-feed-two.vercel.app,http://localhost:8000,http://127.0.0.1:8000

# Authentication & Session Security (Min 32 random characters in production)
SESSION_SECRET=replace-with-a-strong-random-secret-at-least-32-chars
JWT_SECRET=replace-with-a-different-strong-random-secret-at-least-32-chars
EXPORT_SIGNING_SECRET=replace-with-a-different-strong-random-secret-at-least-32-chars

# Clerk Authentication (Optional)
CLERK_PUBLISHABLE_KEY=pk_test_placeholder
CLERK_SECRET_KEY=sk_test_placeholder

# RSS Archiving & Scheduling
RSS_INGESTION_ENABLED=true
RSS_SCHEDULER_ENABLED=true
RETENTION_DAYS=90

# Frontend (Vercel)
VITE_API_BASE_URL=https://your-render-service.onrender.com
